<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp"
    android:background="@color/colorFondo">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adjuntar evidencia fotografica"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="24dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        android:layout_marginBottom="24dp" >

        <ImageView
            android:id="@+id/ivPreviaFoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher_foreground"
            android:background="#E0E0E0" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTomarFoto"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="📷 CÁMARA"
            android:layout_marginEnd="8dp"
            app:cornerRadius="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirGaleria"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_weight="1"
            android:text="🖼️ GALERÍA"
            app:cornerRadius="10dp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvConteoFotos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 fotos seleccionadas"
        android:textSize="14sp"
        android:textStyle="italic"
        android:textColor="#757575"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSeleccionarMultiples"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="📁 SELECCIONAR VARIAS FOTOS"
        app:cornerRadius="10dp"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/pbSubida"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:max="100"
        android:progress="0"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvPorcentaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subiendo: 0%"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubirNube"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SUBIR FOTO A FIREBASE STORAGE"
        app:cornerRadius="8dp"
        app:backgroundTint="#4CAF50"
        android:textColor="@android:color/white"
        android:textStyle="bold" />


</LinearLayout>